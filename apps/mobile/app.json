{
  "expo": {
    "name": "MaterialSetu",
    "slug": "materialsetu",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.materialsetu.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "in.materialsetu.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "materialsetu",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose material photos for your listings.",
          "cameraPermission": "Photograph materials for your listings."
        }
      ],
      "expo-secure-store",
      "expo-document-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "142f793e-5b83-49c3-a390-2bfc741d060a"
      }
    },
    "owner": "dhruvil1309"
  }
}
