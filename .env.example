# Local development only. Production startup must leave DEMO_MODE unset or set to 0.
DEMO_MODE=1
DATABASE_URL=sqlite:///./materialsetu.db
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# --- Website build (read by Vite, not by the Python API) -------------------
# The dev server proxies /api to the local backend, so this is only needed for a
# deployed site that is not served behind a reverse proxy. Set it at build time.
# VITE_API_URL=https://your-api.example.com/api

# --- Hosted PostgreSQL ------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
#
# Supabase, or any host that publishes the `public` schema through its own HTTP
# API, needs DB_SCHEMA set. Without it the tables land in `public`, where the
# project's anonymous browser key can read and write them directly.
# DB_SCHEMA=app
#
# Supabase connection string: Dashboard -> Connect -> Direct -> Transaction pooler.
# Use the pooler host, not db.<ref>.supabase.co - that one is IPv6-only and is
# unreachable from IPv4 hosts such as Render. Port 6543 also turns off client-side
# prepared statements and connection pooling automatically (see services/api/models.py).
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Optional model adapter ------------------------------------------------
# Enables multilingual demand extraction and photo category suggestions. Leave
# unset and the app falls back to the keyword rules in services/api/domain.py,
# which is exactly how it behaved before. Read on the server only: this key must
# never reach the website or the APK.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=20

# --- Evidence storage -------------------------------------------------------
# Without these, uploaded photos, weighing slips and GST documents are written to
# UPLOAD_DIR. That is fine locally, but a container filesystem does not survive a
# restart, so on a hosted deployment the database keeps rows pointing at files
# that no longer exist. Set these and objects go to a private Supabase Storage
# bucket instead. The service key is server-side only and must never reach the
# website or the app.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_KEY=sb_secret_...
# SUPABASE_BUCKET=evidence
